# ==============================================================
# Render & Neon DB Environment Variables Example
# ==============================================================
# Neon PostgreSQL Connection:
# Note: Neon provides URLs like: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# In Spring Boot, ensure the protocol prefix is `jdbc:postgresql://` and append `?sslmode=require`
DB_URL=jdbc:postgresql://ep-your-subdomain.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here

# Port (Render injects PORT automatically, defaults to 8080)
PORT=8080

# CORS Allowed Origins (Comma-separated origins, wildcard supported for vercel preview deployments)
CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://your-custom-domain.com,http://localhost:4321

# Hibernate DDL Auto (Use 'update' for persistent data across Render restarts)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Session Cookie Settings for cross-origin HTTPS requests
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true
